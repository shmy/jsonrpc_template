# 日志级别（tracing / env_logger 风格，如 info、debug、api=debug）
RUST_LOG=info

# HTTP 监听地址
LISTEN_ADDR=0.0.0.0:8080

# 是否以 master 进程启动。MASTER=true：migrate + seed + blob GC。
# clap/未设置 env 时默认 false（多实例安全）；本示例写 true 方便 `cp` 后本地开箱。
# 多实例只开一个 master，或用 just migration-apply 单独迁库。
MASTER=true

# 是否挂载 /docs 文档调试页（默认关闭；本地调试设为 true）
# DOCS_ENABLED=true

# 请求超时 / body 与 batch 上限
# REQUEST_TIMEOUT=60s
# BODY_LIMIT_BYTES=1048576
# MAX_BATCH_LEN=128

# CORS：逗号分隔 Origin 白名单；空 = 不加 CORS 层
# CORS_ORIGINS=

# 可信反代（CIDR/IP，逗号分隔）；非空时才解析 X-Forwarded-For（从右往左）。
# 警告：部署在反代后但不配置此项时，login/refresh 的 Redis IP 窗会按共享出口连坐。
# TRUSTED_PROXIES=

# 应用内限流：仅贵路径 method（login/refresh IP + login 按手机号）。
# 无应用全站 IP 窗——裸跑时公开 HTTP/其它 RPC 不按 IP 限流；生产请在网关/WAF 做全站限流。
# RATE_LIMIT_AUTH_PER_SECOND=5
# RATE_LIMIT_AUTH_BURST=20
# RATE_LIMIT_LOGIN_PHONE_WINDOW=5m
# RATE_LIMIT_LOGIN_PHONE_MAX_ATTEMPTS=10

# OpenTelemetry（api 默认 feature `otlp`；空串关闭 OTLP 导出，仍有本地 span / 响应头 x-request-id）
# OTLP_ENDPOINT=
# OTLP_SERVICE_NAME=jsonrpc-template
# OTLP_METADATA={}
# Trace 采样率 (0,1]；默认 0.1。日志不受此影响
# OTLP_SAMPLER_RATIO=0.1

# Postgres 连接串
# `just db-up`（compose）：宿主机 5433；自建 Postgres 常用 5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jsonrpc_template

# 连接池（当前 toasty 仅支持最大连接数）
# DATABASE_MAX_CONNECTIONS=20

# JWT（登录签发 access token；至少 32 字节）
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32b
JWT_ISSUER=jsonrpc-template
JWT_AUDIENCE=account
ACCESS_TOKEN_TTL=15min
REFRESH_TOKEN_TTL=30d
# 旧 refresh 重放宽限（客户端超时重试）；`0` = 关闭，命中 used 即吊销
# REFRESH_GRACE_TTL=30s

# Redis（会话：access jti / refresh digest）
# compose 映射宿主机 6380；本机自建可用 6379
CACHE_REDIS_URL=redis://127.0.0.1:6379

# Blob —— 按 api feature 二选一（clap：缺必填项即启动失败）
# `blob-fs`（默认）：本地落盘 + GET /files/* 回源
# BLOB_FS_ROOT 有默认 data/blob；DOMAIN / PRESIGN_SECRET 必填
# BLOB_FS_ROOT=data/blob
BLOB_FS_DOMAIN=http://localhost:8080/files
# Fs 本地预签名 HMAC（≥32 字节；与 JWT_SECRET 分开）
BLOB_FS_PRESIGN_SECRET=change-me-blob-presign-secret-32b!!
# file.presign 允许的扩展名（逗号分隔；Content-Type 由 mime_guess 按扩展名解析）
# BLOB_ALLOWED_EXTENSIONS=webp,jpg,jpeg,png,gif,mp4,webm
# `blob-cos`（`--features blob-cos`，勿与 blob-fs 同时开除非 --all-features）：
# BLOB_S3_DOMAIN=https://your-bucket.cos.ap-guangzhou.myqcloud.com
# BLOB_S3_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# BLOB_S3_BUCKET=jsonrpc-template
# BLOB_S3_SECRET_ID=
# BLOB_S3_SECRET_KEY=

# MASTER 启动时种子管理员；phone 已存在则跳过（被普通账号占用时仅告警、不创建管理员）。
# 注意：换 SEED_ADMIN_PHONE 重新部署会播种一个新的管理员，旧管理员需人工处理。
# `just e2e` 使用固定 13800000777 / seed-pass-1（与下列默认不同），勿混用。
# SEED_ADMIN_PHONE=13888888888
# SEED_ADMIN_PASSWORD=admin123!
